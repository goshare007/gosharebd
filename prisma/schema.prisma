generator client {
  provider = "prisma-client"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Division {
  DHAKA
  CHITTAGONG
  SYLHET
  RAJSHAHI
  KHULNA
  BARISAL
  RANGPUR
  MYMENSINGH
}

enum PackageType {
  REGULAR
  FESTIVAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum DepartureStatus {
  ACTIVE    // open for booking
  FULL      // no seats remaining (auto-set when bookedSeats >= totalSeats)
  CANCELLED // admin cancelled this run
  COMPLETED // trip has taken place
}

enum BookingMemberType {
  adult
  preteen
}

enum Gender {
  male
  female
  other
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  imageId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]
  reviews       Review[]
  wishlists     Wishlist[]
  blogPosts     BlogPost[]
  blogComments  BlogComment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Packages ─────────────────────────────────────────────────────────────────

model Package {
  id           String      @id @default(cuid())

  // Identity & Location
  name         String
  slug         String      @unique
  division     Division
  location     String
  tags         String[]

  // Media
  coverImage   String
  coverImageId String
  gallery      GalleryImage[]

  // Pricing
  pricePerPerson      Decimal  @db.Decimal(10, 2)
  originalPrice       Decimal? @db.Decimal(10, 2)
  couplePrice         Decimal? @db.Decimal(10, 2)
  originalCouplePrice Decimal? @db.Decimal(10, 2)
  isCouple            Boolean  @default(false)

  // Details
  durationDays  Int
  maxGroupSize  Int
  minGroupSize  Int
  summary       String
  highlights    String[]

  // Inclusions/Policies
  includes           String[]
  excludes           String[]
  cancellationPolicy String?
  weatherPolicy      String?
  ageRestriction     String?

  // Flags
  isBestseller Boolean     @default(false)
  isActive     Boolean     @default(true)
  packageType  PackageType @default(REGULAR)

  // Relations
  itinerary  Itinerary[]
  reviews    Review[]
  departures Departure[]
  bookings   Booking[]
  wishlists  Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([packageType])
  @@index([isActive, packageType])
  @@index([isActive, packageType, division])
  @@index([division])
  @@index([isBestseller])
  @@index([createdAt])
  @@map("package")
}

model Departure {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  status       DepartureStatus @default(ACTIVE)
  totalSeats   Int
  bookedSeats  Int             @default(0)
  isGuaranteed Boolean         @default(false)

  // Per-departure pricing overrides (null = fall back to package price)
  pricePerPerson      Decimal? @db.Decimal(10, 2)
  originalPrice       Decimal? @db.Decimal(10, 2)
  couplePrice         Decimal? @db.Decimal(10, 2)
  originalCouplePrice Decimal? @db.Decimal(10, 2)

  // e.g. "Eid Special", "Monsoon Tour"
  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([packageId])
  @@index([startDate])
  @@index([packageId, status])
  @@index([status, startDate])
  @@map("departure")
}

model Itinerary {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  time        String
  title       String
  description String
  order       Int

  @@index([packageId])
  @@map("itinerary")
}

model GalleryImage {
  id       String @id @default(cuid())
  url      String
  publicId String // Cloudinary public_id

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("gallery_image")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  avatar  String?
  rating  Int
  comment String
  date    DateTime @default(now())

  // Moderation
  approved    Boolean @default(false)

  // Verified purchase — set to true only if user has a CONFIRMED booking for this package
  isVerified  Boolean @default(false)
  bookingId   String? // reference to the qualifying booking (optional but traceable)

  // Relations
  images ReviewImage[]

  @@unique([userId, packageId]) // one review per user per package
  @@index([packageId])
  @@index([packageId, approved]) // fast: fetch only approved reviews for a package
  @@map("review")
}

model ReviewImage {
  id       String @id @default(cuid())
  url      String
  publicId String // Cloudinary public_id — required for deletion

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@map("review_image")
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id String @id @default(cuid())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  departureId String
  departure   Departure @relation(fields: [departureId], references: [id])

  // Frozen snapshot of departure.startDate at booking time
  travelDate DateTime
  notes      String?

  adultCount   Int
  preteenCount Int
  childCount   Int
  infantCount  Int

  // Pricing snapshot — frozen at booking time
  subtotal Decimal @db.Decimal(10, 2)
  vat      Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members BookingMember[]

  @@index([userId])
  @@index([packageId])
  @@index([departureId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("booking")
}

model BookingMember {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type     BookingMemberType
  fullName String
  gender   Gender
  idNumber String
  email    String
  phone    String

  @@index([bookingId])
  @@map("booking_member")
}

// ─── Subscribers ──────────────────────────────────────────────────────────────

model Subscriber {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  status SubscriberStatus @default(ACTIVE)
  source String?

  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([status])
  @@map("subscriber")
}

// ─── Wishlists ────────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, packageId])
  @@index([userId])
  @@map("wishlist")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model BlogPost {
  id           String   @id @default(cuid())

  // Identity
  title        String
  slug         String   @unique
  excerpt      String   // Short description for cards and SEO meta
  content      String   // TipTap JSONContent stored as JSON string

  // Media
  coverImage   String
  coverImageId String   // Cloudinary public_id for transforms & deletion

  // Taxonomy
  categoryId   String
  category     BlogCategory @relation(fields: [categoryId], references: [id])
  tags         String[]

  // Authorship
  authorId     String
  author       User         @relation(fields: [authorId], references: [id])

  // Status & visibility
  status       BlogStatus   @default(DRAFT)
  featured     Boolean      @default(false)

  // SEO overrides
  metaTitle       String?
  metaDescription String?

  // Denormalized counter — increment via $executeRaw, avoid COUNT() on reads
  viewCount    Int          @default(0)

  // Relations
  images       BlogImage[]
  comments     BlogComment[]

  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([slug])
  @@index([status, publishedAt]) // fast: published posts sorted by date
  @@map("blog_post")
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?

  posts       BlogPost[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("blog_category")
}

// Tracks every image uploaded via TipTap editor or as cover/meta image.
// Enables Cloudinary cleanup on post deletion via onDelete: Cascade.
model BlogImage {
  id       String   @id @default(cuid())

  postId   String?                                                              // ← nullable
  post     BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  url      String
  publicId String

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("blog_image")
}

model BlogComment {
  id     String   @id @default(cuid())

  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Nullable — supports guest comments in the future
  userId String?
  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Snapshot at time of comment — stays accurate even if user renames
  name  String
  email String
  body  String

  // Moderation — new comments are hidden until approved
  approved Boolean @default(false)

  // One level of threading (reply to a top-level comment)
  parentId String?
  parent   BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  BlogComment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([postId, approved]) // fast: only approved comments for a post
  @@map("blog_comment")
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_PENDING
  REVIEW_APPROVED
  REVIEW_REJECTED
  NEW_COMMENT
  PAYMENT_RECEIVED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@map("notification")
}