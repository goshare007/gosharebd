generator client {
  provider = "prisma-client"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]
  reviews       Review[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Destination {
  id        String    @id @default(cuid())
  name      String
  division  String
  summary   String
  image     String
  imageId   String
  tags      String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  packages  Package[]

  @@map("destination")
}

model Package {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  // Identity
  name String
  tags String[]

  // Media
  coverImage   String
  coverImageId String
  gallery      GalleryImage[]

  // Pricing (base defaults — can be overridden per departure)
  pricePerPerson      Decimal  @db.Decimal(10, 2)
  originalPrice       Decimal? @db.Decimal(10, 2)
  couplePrice         Decimal? @db.Decimal(10, 2)
  originalCouplePrice Decimal? @db.Decimal(10, 2)
  isCouple            Boolean  @default(false)

  // Details
  durationDays Int
  maxGroupSize Int
  minGroupSize Int
  Location     String
  summary      String
  highlights   String[]

  // Inclusions
  includes String[]
  excludes String[]

  // Policies
  cancellationPolicy String?
  weatherPolicy      String?
  ageRestriction     String?

  // Flags
  isBestseller Boolean @default(false)
  isActive     Boolean @default(true)

  // Relations
  itinerary  Itinerary[]
  reviews    Review[]
  departures Departure[]
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationId])
  @@map("package")
}

model Departure {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  // Schedule
  // endDate is frozen at creation time (startDate + package.durationDays).
  // Stored explicitly so it remains accurate even if durationDays is later
  // changed on the package.
  startDate DateTime
  endDate   DateTime

  // Status
  status DepartureStatus @default(ACTIVE)

  // Capacity
  // bookedSeats is a denormalized counter incremented atomically inside a
  // transaction when a booking is confirmed. Avoids a COUNT() on every
  // availability check.
  totalSeats  Int
  bookedSeats Int @default(0)

  // Guaranteed flag
  // true  → this departure is confirmed to run regardless of current seat count
  // false → tentative; may be cancelled if minGroupSize is not reached
  isGuaranteed Boolean @default(false)

  // Per-departure pricing overrides (all nullable).
  // When null the booking logic falls back to the parent package prices.
  // Use this for seasonal or promotional pricing without touching the package.
  pricePerPerson      Decimal? @db.Decimal(10, 2)
  originalPrice       Decimal? @db.Decimal(10, 2)
  couplePrice         Decimal? @db.Decimal(10, 2)
  originalCouplePrice Decimal? @db.Decimal(10, 2)

  // Optional human-readable label shown to users on the departure picker,
  // e.g. "Eid Special", "Monsoon Tour", "Long Weekend Package"
  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([packageId])
  @@index([startDate])
  @@index([packageId, status]) // fast lookup: active departures for a package
  @@map("departure")
}

model Itinerary {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  time        String
  title       String
  description String
  order       Int

  @@index([packageId])
  @@map("itinerary")
}

model Review {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  name    String
  avatar  String?
  rating  Int
  comment String
  images  String[]
  date    DateTime @default(now())

  @@index([packageId])
  @@map("review")
}

model GalleryImage {
  id       String @id @default(cuid())
  url      String
  publicId String

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Booking {
  id String @id @default(cuid())

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  departureId String
  departure   Departure @relation(fields: [departureId], references: [id])

  // travelDate is a frozen snapshot of departure.startDate captured at the
  // moment of booking. Kept denormalized so receipts and history remain
  // accurate even if the departure is later edited or cancelled.
  travelDate DateTime
  notes      String?

  // Group composition snapshot
  adultCount   Int
  preteenCount Int
  childCount   Int
  infantCount  Int

  // Pricing snapshot — all values frozen at booking time so the receipt is
  // never affected by future price changes on the package or departure.
  subtotal Decimal @db.Decimal(10, 2)
  vat      Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Status
  status BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members BookingMember[]

  @@index([userId])
  @@index([packageId])
  @@index([departureId])
  @@map("booking")
}

model BookingMember {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type     BookingMemberType
  fullName String
  gender   Gender
  idNumber String
  email    String
  phone    String

  @@index([bookingId])
  @@map("booking_member")
}

// ─── enums ────────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum DepartureStatus {
  ACTIVE    // open for booking
  FULL      // no seats remaining (auto-set when bookedSeats >= totalSeats)
  CANCELLED // admin cancelled this run
  COMPLETED // trip has taken place
}

enum BookingMemberType {
  adult
  preteen
}

enum Gender {
  male
  female
  other
}